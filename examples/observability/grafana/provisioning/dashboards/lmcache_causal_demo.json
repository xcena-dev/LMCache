{
  "uid": "lmcache-causal-demo",
  "title": "LMCache MP \u2014 CXL vs DRAM (lean)",
  "tags": [
    "lmcache",
    "cxl",
    "gpu"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 7,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "description": "CXL vs DRAM KV cache. mp-dram=amber, mp-cxl=teal. TTFT via naru.ttft_otel.",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "\u2460 TTFT \u2014 per-request (live replay of the real request sequence)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Per-request TTFT (ms)",
      "description": "Each point = one real request's TTFT (query/cache-hit, from query_round.csv), replayed ~1 request/sec so it plays as a live line. mp-dram (amber) vs mp-cxl (teal). Real values; x-axis is playback time (requests are far faster than the scrape interval).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "gradientMode": "opacity"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mp-dram"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f0a83c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mp-cxl"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#34e3c4"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "lmcache_mp_request_ttft_ms",
          "legendFormat": "{{service_instance_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "TTFT now (ms)",
      "description": "Current replayed per-request TTFT \u2014 keeps changing every scrape. Summary (mean/p50/p99) is in lmcache_mp_ttft_seconds if needed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mp-dram"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f0a83c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mp-cxl"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#34e3c4"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service_instance_id)(lmcache_mp_request_ttft_ms)",
          "legendFormat": "{{service_instance_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "\u2461 Cache \u2014 is the KV cache working? (both should match)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "L1 hit ratio",
      "description": "Tokens served from L1 (no L2). Control: lines should overlap.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "gradientMode": "opacity"
          },
          "min": 0,
          "max": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mp-dram"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f0a83c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mp-cxl"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#34e3c4"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_instance_id)(rate(lmcache_mp_lookup_hit_tokens_total[$__rate_interval])) / clamp_min(sum by (service_instance_id)(rate(lmcache_mp_lookup_requested_tokens_total[$__rate_interval])),1)",
          "legendFormat": "{{service_instance_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "L1 KV cache footprint",
      "description": "KV bytes resident in L1 (DRAM or CXL). Same 100 GB ceiling.",
