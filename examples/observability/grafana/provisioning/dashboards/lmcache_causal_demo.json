          {
            "matcher": {
              "id": "byName",
              "options": "mp-cxl"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#34e3c4"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(lmcache_mp_l0_l1_load_throughput_GB_per_second_sum[$__rate_interval]) / clamp_min(rate(lmcache_mp_l0_l1_load_throughput_GB_per_second_count[$__rate_interval]),1)",
          "legendFormat": "{{service_instance_id}}",
          "refId": "A"
        }
      ]
    },
