    {
      "id": 8,
      "type": "timeseries",
      "title": "KV retrieve throughput  L1\u2192L0 (GB/s)",
      "description": "KV-only load speed (LMCache self-timed on the GPU stream). This is a PCIe H2D DMA under the hood, but scoped to KV \u2014 the precise retrieve-path signal (vs total PCIe, which also carries weights/inputs and can't tell DRAM from CXL source).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
