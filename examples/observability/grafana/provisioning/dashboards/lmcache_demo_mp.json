            "fillOpacity": 25,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "memory used"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mp-cxl"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#F2A93B",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "w/ CXL"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mp-dram"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#5B8FF9",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "w/o CXL"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "③ GPU utilization (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "lmcache_mp_gpu_utilization_ratio * 100",
          "legendFormat": "{{service_instance_id}} gpu{{gpu}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
