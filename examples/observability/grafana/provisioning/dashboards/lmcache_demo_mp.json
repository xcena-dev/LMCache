{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "liveNow": true,
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "lmcache",
    "demo",
    "mp"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "LMCache DEMO — MP mode (CXL vs DRAM)",
  "uid": "lmcache-demo-mp",
  "version": 5,
  "panels": [
    {
      "type": "stat",
      "title": "TTFT now — cache hit p50 (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service_instance_id)(lmcache_mp_ttft_seconds{stat=\"p50\",phase=~\".*cache_hit.*\",service_instance_id=~\"mp-dram|mp-cxl\"}) * 1000",
          "legendFormat": "{{service_instance_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2000
              },
              {
                "color": "red",
                "value": 6000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 40,
          "valueSize": 90
        }
      }
    },
    {
      "type": "timeseries",
      "title": "① TTFT — cache-hit p50 (ms)   [w/CXL vs w/o CXL]",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (service_instance_id)(lmcache_mp_ttft_seconds{stat=\"p50\",phase=~\".*cache_hit.*\",service_instance_id=~\"mp-dram|mp-cxl\"}) * 1000",
          "legendFormat": "{{service_instance_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 4,
            "fillOpacity": 12,
            "showPoints": "always",
            "pointSize": 10,
            "spanNulls": true,
            "axisLabel": "TTFT (ms)"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mp-cxl"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#F2A93B",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "w/ CXL"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mp-dram"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#5B8FF9",
                  "mode": "fixed"
                }
              },
              {
                "id": "displayName",
                "value": "w/o CXL"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "② KV footprint — memory used (L1)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "lmcache_mp_l1_memory_usage_bytes",
          "legendFormat": "{{service_instance_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
